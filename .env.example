# Copy to .env.local and fill values. Full checklist: docs/env-setup.md

# Auth.js
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitLab import (optional)
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
# GITLAB_BASE_URL=https://gitlab.com

# Linear ticket enrichment — Solo + Pro (optional)
AUTH_LINEAR_ID=
AUTH_LINEAR_SECRET=

# AI (at least one)
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_GATEWAY_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SOLO_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Annual prices (~15% off) — create yearly Prices in Stripe Dashboard
# STRIPE_SOLO_ANNUAL_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# STRIPE_SOLO_ANNUAL_PRICE_ID_USD=
# STRIPE_PRO_ANNUAL_PRICE_ID_USD=
# STRIPE_SOLO_PRICE_ID_USD=
# STRIPE_PRO_PRICE_ID_USD=
# STRIPE_SOLO_PRICE_ID_GBP=
# STRIPE_PRO_PRICE_ID_GBP=
# STRIPE_SOLO_PRICE_ID_JPY=
# STRIPE_PRO_PRICE_ID_JPY=
# STRIPE_SOLO_PRICE_ID_KRW=
# STRIPE_PRO_PRICE_ID_KRW=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional — welcome, trial, billing emails)
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Easy Patch <hello@yourdomain.com>

# Cron jobs (Vercel — generate a random secret)
# CRON_SECRET=

# GitHub release webhooks (optional — also set in GitHub repo webhook settings)
# GITHUB_WEBHOOK_SECRET=

# Analytics (optional)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=easypatch.app

# Error monitoring (optional — set DSN to enable Sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Discord bot (optional — see docs/discord-bot.md)
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
