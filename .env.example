# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# URL publique (obligatoire hors Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Diagnostic prod (optionnel) — /api/env-check?secret=...
