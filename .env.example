# Auth (NextAuth) — openssl rand -base64 32 pour AUTH_SECRET
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase (Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA — une des deux suffit
GOOGLE_GENERATIVE_AI_API_KEY=
